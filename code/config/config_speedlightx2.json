{
  "input": {
    "path": "../../data_timing/lab_data/46speedoflighttryx2 correct",
    "pattern": "RAW/DataR_*.root",
    "tree": "Data_R"
  },
  "output": {
    "path": "speedlightx2",
    "save_root": true
  },
  "plot": {
    "enabled": true,
    "width": 1600,
    "height": 1000,
    "log_y": false
  },
  "histograms": [
    {
      "name": "Energy",
      "expression": "Energy",
      "bins": 800,
      "x_range": [
        1700,
        3400
      ],
      "title": "Speed of light measurement with X2",
      "x_title": "ADC channel",
      "y_title": "Entries",
      "fits": [
        {
          "name": "TAC",
          "function": "gaus",
          "range": [
            2600,
            2750
          ],
          "channels": [
            2
          ],
          "parameters": [
            {
              "index": 1,
              "name": "mean"
            },
            {
              "index": 2,
              "name": "sigma"
            }
          ]
        }
      ]
    }
  ]
}
