{
  "input": {
    "path": "../data_timing/lab_data/43calibcable80cmcorrect_1",
    "pattern": "RAW/DataR_*.root",
    "tree": "Data_R"
  },
  "output": {
    "path": "output_tac_80cm",
    "save_root": true
  },
  "plot": {
    "enabled": true,
    "width": 1600,
    "height": 1000,
    "log_y": false
  },
  "histograms": [
    {
      "name": "Energy",
      "expression": "Energy",
      "bins": 800,
      "x_range": [0,1000],
      "title": "TAC calibration with 80 cm cable",
      "x_title": "ADC channel",
      "y_title": "Entries",
      "fits": [
        {
          "name": "TAC",
          "function": "gaus",
          "range": [200,320],
          "channels": [2],
          "parameters": [
            { "index": 1, "name": "mean" },
            { "index": 2, "name": "sigma" }
          ]
        }
      ]
    }
  ]
}
